.env
backups/
*.log

# Installed by the Docker build, and by hand when testing a service locally.
node_modules/
__pycache__/
*.pyc

# Written by `make up` at deploy time, read by the agent: the list of commits
# that are actually running on this box. Generated from git, so committing it
# would mean a file whose content is a description of the commit before it.
.platform-state/

# Local state, never committed: the partner snapshot and their mockups.
partner/source/
partner/source-*/
partner/source.*/
# Anchored to the root. Unanchored it matched any directory of that name at any
# depth, which silently swallowed docs/mockups/ — a design decision that looked
# committed and was not. What this is actually protecting is the copy-out
# target of `make partner-mockups`, which is only ever ./mockups.
/mockups/

# npm writes this when dependencies are installed for local testing. The
# images build from package.json alone, so a committed lock is never used —
# it only drifts from what actually ships.
agent/package-lock.json
analytics/package-lock.json
board/package-lock.json
cfm/package-lock.json

# A copy of the server with "; Secure" stripped from the cookies, made while
# testing: local Chromium will not send a Secure cookie over plain http, so the
# signed-in and on-the-list paths cannot be walked in a browser without one. It
# is generated per run and must never ship — a board that sets its cookies
# without Secure is a board handing them to anybody on the network.
board/server.nosec.mjs
cfm/server.nosec.mjs
cfm/node_modules/
