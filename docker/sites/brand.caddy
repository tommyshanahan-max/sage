# The brand's public homepage — the one page here meant for people who were
# never given a password. Inert until TOMSCODING_BRAND_DOMAIN is set: unset, it
# binds an internal .localhost name and requests no certificate. That fallback
# must stay distinct from every other one, because two site blocks sharing an
# address is a startup failure, not a warning.
#
# It runs on Caddy alone. There is no container behind it and nothing to start
# in COMPOSE_PROFILES — the page is a file on disk, served read-only.
{$TOMSCODING_BRAND_DOMAIN:brand.localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	# Same trick as the landing page: the HTML holds short paths, and the real
	# hostnames are filled in from the environment here. A seat that is not
	# configured redirects to its internal .localhost fallback and lands
	# nowhere, which is the honest outcome for a door that does not exist.
	@app path /app /app/
	redir @app https://{$TOMSCODING_BRAND_APP_DOMAIN}/

	@seat1 path /admin /admin/ /admin/1 /admin/1/
	redir @seat1 https://{$TOMSCODING_PARTNER_DOMAIN}/

	@seat2 path /admin/2 /admin/2/
	redir @seat2 https://{$TOMSCODING_PARTNER2_DOMAIN}/

	@numbers path /admin/numbers /admin/numbers/
	redir @numbers https://{$TOMSCODING_STATS_DOMAIN}/

	# The counter's two public paths, and only those two. The dashboard is not
	# reachable from this hostname at all — it lives on the stats hostname
	# behind a password, and there is nothing to be gained by having a second
	# door to it on the page everybody can see.
	#
	# Same origin as the page, so reporting a visit needs no CORS preflight and
	# no third-party request, on a connection where every extra round trip is
	# one that can fail.
	@count path /a/e /a/lx.js
	handle @count {
		uri strip_prefix /a
		reverse_proxy analytics:3000
	}

	# Everything else is the page itself. It reads the brand name, the app's
	# address and the seats' names out of the environment, so moving any of them
	# is a .env change. Everything substituted is configuration written by the
	# owner — no request data reaches the template.
	handle {
		root * /srv/brand
		templates
		file_server
	}
}

# The apex is the brand, www redirects to it. A homepage people type or paste is
# a different thing from a service hostname: someone will write the www in, and
# a certificate error on the front door reads as the company being broken.
#
# Its own site block, since Caddy substitutes one variable per address. Unset,
# it binds a distinct .localhost name and does nothing.
{$TOMSCODING_BRAND_WWW:www.brand.localhost} {
	redir https://{$TOMSCODING_BRAND_DOMAIN}{uri} permanent
}
