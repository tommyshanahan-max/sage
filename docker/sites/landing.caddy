# The public front door. Separate hostname from the IDE, separate certificate,
# separate site block — it shares nothing with the workspace but the process
# serving it.
#
# Don't want a landing page? Delete this file and leave TOMSCODING_LANDING_DOMAIN
# unset. The fallback below binds a .localhost name, which Caddy treats as
# internal — no ACME, nothing public. It must stay distinct from the fallback
# in workspace-2.caddy: two site blocks sharing one address is a hard startup
# failure, so a plain `localhost` in both would break every deployment that
# configured neither.
{$TOMSCODING_LANDING_DOMAIN:landing.localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	# Keeps the HTML free of hardcoded hostnames: the page links to short paths
	# and the real domains are filled in here from the environment. Moving the
	# deployment to another domain then touches .env and nothing else.
	#
	# A path whose service is not configured redirects to that service's
	# internal .localhost fallback and lands nowhere, which is the honest
	# outcome — the tile is for something this deployment does not run.
	@ide path /ide /ide/
	redir @ide https://{$TOMSCODING_DOMAIN}/

	@seat2 path /seat2 /seat2/
	redir @seat2 https://{$TOMSCODING_DOMAIN_2}/

	@browser path /browser /browser/
	redir @browser https://{$TOMSCODING_BROWSER_DOMAIN}/

	@agent path /agent /agent/
	redir @agent https://{$TOMSCODING_AGENT_DOMAIN}/

	root * /srv/landing
	file_server
}
