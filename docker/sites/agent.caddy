# The agent chat app, on its own hostname. Inert until TOMSCODING_AGENT_DOMAIN
# is set: unset, this binds an internal .localhost name and requests no
# certificate. Distinct from the other fallbacks on purpose — two site blocks
# sharing an address is a startup failure, not a warning.
#
# Starting the container is separate, via COMPOSE_PROFILES in .env.
{$TOMSCODING_AGENT_DOMAIN:agent.localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	# The reply streams as Server-Sent Events. Caddy passes these through
	# unbuffered on its own, and the app sets no-transform besides, so a turn
	# appears as it is written rather than all at once when it ends.
	reverse_proxy agent:3000
}
