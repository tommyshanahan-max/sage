# The seat that runs The Feed, on its own hostname. Inert until
# TOMSCODING_FEED_DOMAIN is set: unset, this binds an internal .localhost name
# and requests no certificate. Distinct from the other fallbacks on purpose —
# two site blocks sharing an address is a startup failure, not a warning, and
# it takes every site on the box down with it.
#
# Starting the container is separate, via COMPOSE_PROFILES in .env.
{$TOMSCODING_FEED_DOMAIN:thefeed.localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	# Same streaming behaviour as the other seats: Caddy passes Server-Sent
	# Events through unbuffered, so a reply appears as it is written.
	reverse_proxy thefeed:3000
}
