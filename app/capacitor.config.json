{
  "appId": "app.thexchange",
  "appName": "The Exchange",
  "webDir": "www",
  "server": {
    "url": "https://thexchange.app",
    "cleartext": false,
    "allowNavigation": [
      "thexchange.app",
      "*.thexchange.app",
      "liuxuesheng.io",
      "*.liuxuesheng.io"
    ]
  },
  "ios": {
    "backgroundColor": "#141A24",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["alert", "sound"]
    }
  }
}
