# Copy to .env and fill in. .env is gitignored — it holds real secrets.

# The hostname for the IDE itself. A subdomain, not your apex — code-server
# gets a whole hostname to itself, which avoids the sub-path proxying that
# tends to break its websocket. Needs an A record before `make up`.
TOMSCODING_DOMAIN=code.example.com

# The hostname for the public landing page in ./landing. Typically your apex.
# Needs its own A record, and gets its own certificate. Leave blank if you
# don't want a public front door — the IDE works either way.
TOMSCODING_LANDING_DOMAIN=example.com

# Let's Encrypt uses this for expiry warnings. A real address you read.
TOMSCODING_ACME_EMAIL=you@example.com

# The password for the IDE. This is the only thing between the public internet
# and a root-capable shell — generate it, do not invent it:
#   openssl rand -base64 24
TOMSCODING_PASSWORD=

# Optional. If set, Claude Code picks it up without an interactive login.
# Leave blank to run `claude` once in the IDE terminal and log in there.
ANTHROPIC_API_KEY=

# Optional git identity for commits made from the workspace.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# Container timezone. Asia/Shanghai keeps timestamps matching your wall clock.
TZ=Asia/Shanghai

# Memory ceiling for the workspace container. Keep ~1G headroom below the
# VPS total so the host and Caddy stay responsive under a heavy build.
TOMSCODING_WORKSPACE_MEMORY=3g

# Relative CPU weight for this seat. Only matters when both seats are busy at
# once; the scheduler then divides time in proportion to the two numbers. An
# idle seat gives up its share entirely, so this never slows a quiet box.
TOMSCODING_CPU_SHARES=1024

# ---------------------------------------------------------------------------
# Second seat — a fully separate workspace for another person.
#
# Own container, own home volume, own password, own hostname. The two cannot
# see each other's files, terminals or editor state. They do share the VPS, so
# a heavy build on one slows the other, and they share the IP.
#
# Delete this whole block (or clear COMPOSE_PROFILES) for a single-seat setup.
# ---------------------------------------------------------------------------

# Starts the second workspace. Read by Docker Compose itself, not by the
# services — clearing it means the container is never created at all.
COMPOSE_PROFILES=seat2

# Hostname for the second seat. Needs its own A record and gets its own
# certificate, same as the others.
TOMSCODING_DOMAIN_2=her.example.com

# Her password. Generate it — `make password` — do not reuse yours. This is a
# second root-capable shell on the public internet, and it is only ever as
# strong as whichever of the two passwords is weaker.
TOMSCODING_PASSWORD_2=

# Lower ceiling than the primary, sized for editing rather than heavy builds.
# The two limits plus ~1G for the host should fit inside the VPS's RAM: on a
# 4 GB box use 2g here and 1g there; two seats are much happier on 8 GB.
TOMSCODING_WORKSPACE_2_MEMORY=1500m

# Half the primary's weight: under contention roughly a third of the CPU here
# and two thirds there. Raise it to 1024 to make the seats equal.
TOMSCODING_CPU_SHARES_2=512

# ---------------------------------------------------------------------------
# crowdfundme — the ledger
# ---------------------------------------------------------------------------

# Its hostname. Unset, the site block binds an internal .localhost name and
# asks for no certificate. Every hostname here must also be named in Caddy's
# own environment block in docker-compose.yml, or Caddy never learns about it
# and the browser gets ERR_SSL_PROTOCOL_ERROR from a site that looks up.
TOMSCODING_CFM_DOMAIN=
TOMSCODING_CFM_WWW=

# The master key. Without it every admin route refuses, which is the safe
# failure. Generate it with `make password`.
TOMSCODING_CFM_KEY=

# Signs the cookies that carry an opened offer and a signed-in founder.
TOMSCODING_CFM_SALT=

# ANCHORING, off unless the secret is set.
#
# One small Stellar transaction per sealed month, carrying that month's hash.
# Unset, months still seal and chain — they stay on this box, and the pages
# say exactly that instead of implying more. Set it and the same pages point
# at transactions anybody can open and check without asking you.
#
# This is a spending key. Use a throwaway account holding only the lumens the
# fees need, never one that holds anything. Find the account it derives from
# with `make cfm-anchoring`, which also prints the free testnet funding link.
TOMSCODING_CFM_STELLAR_SECRET=

# "test" or "public". Left alone it is test, deliberately: a public anchor
# costs real lumens and cannot be taken back.
TOMSCODING_CFM_STELLAR_NET=test

# How many strangers may start a record in an hour. Anybody can start one —
# that is the product — but the ledger is one JSON file and a script fills it
# faster than a person reads it.
TOMSCODING_CFM_NEW_PER_HOUR=20

# APPLE'S PUSH, FOR THE APP STORE BUILD.
#
# The board already sends Web Push, which reaches a browser and a PWA on a
# home screen. It does not reach a phone holding an App Store build: a
# WKWebView has no Push API, so the app would ship with notifications silently
# off — and notifications are the whole reason it is worth being an app.
#
# Both halves run at once. Nobody is moved off the web version, and one person
# may have the site on one phone and the app on another.
#
# KEY    the .p8 from developer.apple.com, contents and all. It belongs to a
#        TEAM rather than to an app, so the key already minted for another app
#        in the same account is the one to use here.
# KEY_ID the ten characters Apple names that key by.
# TEAM   the team it belongs to, also ten characters.
# TOPIC  the app's bundle id, e.g. app.thexchange.
# HOST   "sandbox" while building against a development build, empty for the
#        real one. A token from the wrong half is answered 400 BadDeviceToken,
#        which reads like a broken token rather than a build talking to the
#        wrong house.
#
# Unset, none of this exists and the web half carries on alone.
TOMSCODING_BOARD_APNS_KEY=
TOMSCODING_BOARD_APNS_KEY_ID=
TOMSCODING_BOARD_APNS_TEAM=
TOMSCODING_BOARD_APNS_TOPIC=
TOMSCODING_BOARD_APNS_HOST=

# WHO A READER CAN REACH WHO IS NOT THIS SOFTWARE.
#
# An address on the terms page and beside the report screens. An app store will
# not carry anything carrying what people write without one, and it is the
# right thing on a board regardless: the person being harassed, and the person
# whose report nobody acted on, both need somewhere to go that is not the
# machine that ignored them.
#
# Unset, /terms tells them to raise it in a room instead, which is true — it
# reaches the operator — and is better than printing "write to " with nothing
# after it. Set it before submitting to any store.
TOMSCODING_BOARD_CONTACT=

# THE EARLY-ADOPTER LEDGER, pinned over the rewards door. Off entirely unless
# GOAL is set, and setting it is a promise to everybody who then sees it — so
# it is a deliberate line here and never a default that arrives with a rebuild.
#
# GOAL   the membership at which the company intends to make a share offer.
#        Unset, no screen draws and the route answers {on:false}. It is NOT
#        where the ledger closes: places are handed out in four tiers ending at
#        10,000 (see LAYERS in board/lib/store.js) and the goal is a separate,
#        larger number the company is aiming at.
# UNTIL  the day the activity half stops counting.
# BY     the day the goal is meant to be reached.
# SPLIT  percent of the pool allocated by place rather than by what people did
#        (default 70).
# ROOMS  which doors carry it, comma separated, from: wait film invest raise
#        trade other. The rewards door always carries it and needs no listing.
# GUESTS how many people one member is counted for (default 10).
TOMSCODING_BOARD_LEDGER_GOAL=
TOMSCODING_BOARD_LEDGER_UNTIL=
TOMSCODING_BOARD_LEDGER_BY=
TOMSCODING_BOARD_LEDGER_SPLIT=
TOMSCODING_BOARD_LEDGER_ROOMS=
TOMSCODING_BOARD_LEDGER_GUESTS=
# Money on the rewards panel. CUT is what percent of a sale the members' pool
# represents, and it is required for any of it to appear. Then EITHER or BOTH
# of two figures, which are two different sentences:
#   SALE     what the company might be worth TODAY  -> "If it sold today".
#   SALE_AT  what it might be worth AT THE GOAL     -> the headline box,
#            "If we reach 50,000 members".
# SALE_AT stands on its own: showing what a share comes to at the goal does not
# oblige anybody to also publish a smaller figure for today.
# Unset, the panel shows points and a percentage and no currency appears on it.
# It is arithmetic on numbers the operator typed and the screen says so — it is
# not a valuation and it is not a forecast.
TOMSCODING_BOARD_LEDGER_SALE=
TOMSCODING_BOARD_LEDGER_CUT=
# And what it might be worth if the goal is reached, so the panel can show the
# two side by side. Only the sale figure differs between them: the share is
# divided by every place there will ever be, so it does not move.
TOMSCODING_BOARD_LEDGER_SALE_AT=

# ---- The wallet (docs/wallet.md) ----------------------------------------------
# Off unless set. `test` = stand-in provider, no money moves. `airwallex` = real,
# not ready yet. TEST_CONFIRM=1 lets browsers without passkeys confirm in test
# mode only.
TOMSCODING_BOARD_WALLET=
TOMSCODING_BOARD_WALLET_TEST_CONFIRM=
TOMSCODING_BOARD_WALLET_AIRWALLEX_CLIENT_ID=
TOMSCODING_BOARD_WALLET_AIRWALLEX_API_KEY=
TOMSCODING_BOARD_WALLET_AIRWALLEX_WEBHOOK_SECRET=
TOMSCODING_BOARD_WALLET_AIRWALLEX_SANDBOX=1
TOMSCODING_BOARD_WALLET_PUBLIC_ORIGIN=
