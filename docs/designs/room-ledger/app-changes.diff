diff --git a/board/server.js b/board/server.js
index 14e519b..29fbc4d 100644
--- a/board/server.js
+++ b/board/server.js
@@ -7806,6 +7806,122 @@ app.get("/api/door", notesOff, async (req, res) => {
  *  the clock running: they still have to open it, write a name and a line, and
  *  put up a face. Nothing here mints a code and nothing here makes a member.
  */
+/* ---------------------------------------------------------------------------
+ * PROTOTYPE — THE 50,000 LEDGER, PINNED TO THE TOP OF A DOOR ROOM
+ *
+ * Not for the box. Every member gets a place number the day their page goes
+ * up, and the place is worth points on a sliding scale: SCALE ÷ place^CURVE,
+ * so #1 is 1,000 and #50,000 is 23 at the default curve. What they do adds
+ * more, with the same weights the seat ledger pays, and guests capped so that
+ * bringing people in helps without becoming the way to earn.
+ *
+ * NO MONEY, AND NO PROMISE OF SHARES. Points have no cash value and cannot be
+ * sold. The rules say the company intends to make a share offer to everybody
+ * on the ledger if the board reaches GOAL members, allocated by points, through
+ * an offer document of its own. A signed promise of shares to fifty thousand
+ * people would be a public share offer, which is why nothing here is signed.
+ *
+ * THE PLACE SHARE IS DIVIDED BY EVERY PLACE UP TO GOAL, not by today's
+ * members — the same reason POOL divides by the full hundred. Fixed the day
+ * you join, it never falls as other people arrive.
+ *
+ * Joining the ledger is kept in its own file beside the board rather than in
+ * board.json, so the prototype adds no field that cleanBoard would have to
+ * learn about.
+ * ------------------------------------------------------------------------- */
+const LEDGER_GOAL = Math.max(0, Math.round(Number(process.env.BOARD_LEDGER_GOAL || 0)));
+const LEDGER_CURVE = Math.min(1, Math.max(0.1, Number(process.env.BOARD_LEDGER_CURVE || 0.35)));
+const LEDGER_SPLIT = Math.min(100, Math.max(0, Number(process.env.BOARD_LEDGER_SPLIT ?? 70)));
+const LEDGER_BY = /^\d{4}-\d{2}-\d{2}$/.test(process.env.BOARD_LEDGER_BY || "") ? process.env.BOARD_LEDGER_BY : "";
+const LEDGER_CUTOFF = /^\d{4}-\d{2}-\d{2}$/.test(process.env.BOARD_LEDGER_CUTOFF || "") ? process.env.BOARD_LEDGER_CUTOFF : "";
+const LEDGER_SCALE = 1000;
+const LEDGER_GUESTS = 10;
+const LEDGER_RULES = "1.0";
+const LEDGER_FILE = path.join(DIR, "ledger-proto.json");
+
+const placePoints = (n) => Math.round(LEDGER_SCALE / Math.pow(Math.max(1, n), LEDGER_CURVE));
+const PLACE_SUM = (() => { let t = 0; for (let n = 1; n <= LEDGER_GOAL; n++) t += placePoints(n); return t; })();
+
+/** What somebody has done, the seat ledger's weights, guests capped. */
+function ledgerActivity(board, who) {
+  const live = (p) => p.state === "published" && !p.like && !p.report;
+  const myPosts = board.posts.filter((p) => p.by === who && live(p) && !p.re);
+  const myIds = new Set(myPosts.map((p) => p.id));
+  const answerers = new Set();
+  for (const p of board.posts) {
+    if (p.re && myIds.has(p.re) && live(p) && p.by && p.by !== who) answerers.add(p.by);
+  }
+  for (const n of board.notes) if (n.to === who && n.by && n.by !== who) answerers.add(n.by);
+  const guests = board.invites
+    .filter((v) => v.by === who && v.usedBy)
+    .map((v) => board.people.find((x) => x.by === v.usedBy))
+    .filter((g) => g && g.state === "published" && board.posts.some((p) => p.by === g.by && live(p)));
+  const counted = Math.min(guests.length, LEDGER_GUESTS);
+  const cards = board.cards.filter((c) => c.by === who).length;
+  const weeks = new Set(board.posts.filter((p) => p.by === who && live(p))
+    .map((p) => weekKey(new Date(Date.parse(p.at || "") || Date.now())))).size;
+  return [
+    { key: "guests", n: guests.length, counted, points: counted * WORTH.guest },
+    { key: "cards", n: cards, points: cards * WORTH.card },
+    { key: "heard", n: answerers.size, points: answerers.size * WORTH.heard },
+    { key: "weeks", n: weeks, points: weeks * WORTH.week },
+  ].filter((r) => r.n > 0);
+}
+
+async function ledgerJoins() {
+  try { return JSON.parse(await readFile(LEDGER_FILE, "utf8")); } catch { return { joins: {} }; }
+}
+
+app.get("/api/ledger/pin", notesOff, async (req, res) => {
+  res.set("Cache-Control", "no-store");
+  const me = hashDevice(String(req.get("x-board-device") || ""), SALT) || waitCookie(req);
+  if (!store.doorRoom(String(req.query.room || ""))) return res.status(404).json({ error: "no" });
+  if (!me || !LEDGER_GOAL) return res.json({ on: false });
+  const board = await store.load(FILE);
+  const order = board.people
+    .filter((q) => q.state === "published" && q.handle)
+    .sort((a, b) => String(a.at).localeCompare(String(b.at)));
+  const members = order.length;
+  const place = order.findIndex((q) => q.by === me) + 1;
+  const head = {
+    on: true, goal: LEDGER_GOAL, by: LEDGER_BY, cutoff: LEDGER_CUTOFF, split: LEDGER_SPLIT,
+    rules: LEDGER_RULES, guestCap: LEDGER_GUESTS, members,
+    marks: [1, 100, 1000, 10000, LEDGER_GOAL].filter((n) => n <= LEDGER_GOAL)
+      .map((n) => ({ n, points: placePoints(n) })),
+  };
+  // Somebody still at the door has no place yet, and the pin says so.
+  if (!place) return res.json({ ...head, member: false });
+  const parts = ledgerActivity(board, me);
+  const activity = parts.reduce((a, r) => a + r.points, 0);
+  const own = placePoints(place);
+  const joined = (await ledgerJoins()).joins[me] || null;
+  res.json({
+    ...head, member: true, place, placePoints: own, activity, parts,
+    total: own + activity,
+    /* Percent of the whole pool, from place alone. Fixed on the day of joining. */
+    placeShare: PLACE_SUM ? (own / PLACE_SUM) * LEDGER_SPLIT : 0,
+    beyond: place > LEDGER_GOAL,
+    joined: joined && { at: joined.at, where: joined.where, rules: joined.rules },
+  });
+});
+
+app.post("/api/ledger/join", notesOff, express.json({ limit: "1kb" }), async (req, res) => {
+  const me = hashDevice(String(req.body?.device || ""), SALT);
+  const where = ["hk", "cn", "else"].includes(req.body?.where) ? req.body.where : "";
+  if (!me || !LEDGER_GOAL) return res.status(400).json({ error: "no" });
+  if (!where || req.body?.agreed !== true) return res.status(400).json({ error: "incomplete" });
+  const board = await store.load(FILE);
+  if (!board.people.some((q) => q.by === me && q.state === "published" && q.handle)) {
+    return res.status(403).json({ error: "notmember" });
+  }
+  const data = await ledgerJoins();
+  data.joins = data.joins || {};
+  data.joins[me] = { at: new Date().toISOString(), where, rules: LEDGER_RULES };
+  await mkdir(DIR, { recursive: true });
+  await writeFile(LEDGER_FILE, JSON.stringify(data, null, 2) + "\n", "utf8");
+  res.json({ ok: true, joined: data.joins[me] });
+});
+
 app.post("/api/door/up", notesOff, express.json({ limit: "2kb" }), async (req, res) => {
